{
  "version": 2,
  "builds": [
    {
      "src": "web/**",
      "use": "@vercel/static"
    },
    {
      "src": "data/accounts.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/web/index.html"
    },
    {
      "src": "/data/accounts.json",
      "dest": "/data/accounts.json"
    },
    {
      "src": "/(.*)",
      "dest": "/web/$1"
    }
  ]
}
